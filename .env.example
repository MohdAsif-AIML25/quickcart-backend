# Copy this file to .env and adjust values. Never commit .env.
APP_NAME=QuickCart API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

POSTGRES_USER=quickcart
POSTGRES_PASSWORD=quickcart_dev_password
POSTGRES_DB=quickcart
DATABASE_URL=postgresql+psycopg://quickcart:quickcart_dev_password@localhost:5433/quickcart

JWT_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0
PRODUCT_CACHE_TTL_SECONDS=60
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=2