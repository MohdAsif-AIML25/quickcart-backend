# Copy to .env.prod ON THE SERVER and fill in real values. Never commit .env.prod.
# Use only letters and digits in the password: it is placed inside a database URL.
POSTGRES_USER=quickcart
POSTGRES_PASSWORD=change-me-use-a-long-random-value
POSTGRES_DB=quickcart
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-new-one-for-production
# Only for HTTPS (docker-compose.https.yml): the domain name that points to the server.
# No "https://" and no path. Example: shop.example.com
SITE_ADDRESS=
